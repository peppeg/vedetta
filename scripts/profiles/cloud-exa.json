{
  "_comment": "SPEC_EXA profile E: Exa for search (Brave as backup) and as reader after http; PDFs go to the built-in reader. No keys here: ${NAME} is filled from the repo .env at prepare time.",
  "default_search_provider": "exa",
  "search_providers": ["exa", "brave"],
  "reader_providers": ["http", "exa"],
  "exa_api_key": "${EXA_API_KEY}",
  "exa_search_type": "auto",
  "llm_default_id": "default",
  "llm_endpoints": [
    {
      "id": "default",
      "name": "entrim-deepseek",
      "base_url": "https://api.entrim.ai/v1",
      "model": "deepseek-ai/DeepSeek-V4.1-Flash",
      "api_key": "${ENTRIM_API_KEY}"
    }
  ],
  "llm_base_url": "https://api.entrim.ai/v1",
  "llm_model": "deepseek-ai/DeepSeek-V4.1-Flash",
  "llm_api_key": "${ENTRIM_API_KEY}"
}
