# Vedetta — configuration example
#
# Copy this file to .env and keep ONE of the two examples below: HOME (everything on
# your own machines) or CLOUD (search, reading and the model as online services).
# Settings saved from the web interface go to data/config.local and win over this file.
#
# Out of the box Vedetta runs as we test it: the Deep research with all its checks on,
# medium effort, temperature 1.0 and top_p 0.95, pages read by the built-in reader and
# then by Jina, searches and pages remembered for a while (data/cache).

VEDETTA_PORT=3030
# Who can reach Vedetta: 127.0.0.1 = only this machine (the default). To use it from
# other devices (a phone, another computer): 0.0.0.0, or this machine's home address.
# Without an access code anyone on the network can use it: Vedetta says so at start.
# With a code, each device types it once and is remembered for a year. The access code
# and the settings code are set in Settings ("Accesso"); a code written here wins
# and is changed only here.
# VEDETTA_BIND=0.0.0.0
# VEDETTA_ACCESS_CODE=

# =====================================================================================
# HOME example: SearXNG, Jina Reader and a model served on your network
# =====================================================================================
SEARXNG_API_URL=http://localhost:8888
JINA_READER_URL=http://localhost:3001
# Any OpenAI-compatible server: llama.cpp, vLLM, Ollama, LM Studio, Lemonade...
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3.8-flash-next
LLM_API_KEY=
# Qwen models also want top_k 20 (their recommended sampling); leave it out for others.
VEDETTA_DEEP_LOOP_TOP_K=20

# =====================================================================================
# CLOUD example: paid services, each with its key (comment out the HOME block above)
# =====================================================================================
# SEARCH_PROVIDERS=brave,tavily
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# READER_PROVIDERS=http,firecrawl
# FIRECRAWL_API_KEY=
# LLM_BASE_URL=https://api.kilo.ai/api/gateway
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_API_KEY=

# =====================================================================================
# Optional
# =====================================================================================
# A second code, for Settings only (services, models, memory): with it, the access
# code lets people search and read, and only you change the settings. In Settings the
# first one is set from the machine Vedetta runs on.
# VEDETTA_CONFIG_TOKEN=

# Names Vedetta answers to besides IP addresses and home names (no dot, .local, .lan,
# .home, .localdomain, .home.arpa, .internal, .ts.net): a domain behind a reverse proxy,
# or a router name like name.fritz.box, goes here.
# VEDETTA_ALLOWED_HOSTS=vedetta.example.org
# Other web pages allowed to call Vedetta's API (exact origins, comma separated).
# VEDETTA_CORS_ORIGINS=https://tool.example.org

# Other services: SERP_API_KEY (Serper), EXA_API_KEY (Exa search and reader),
# BROWSER_CDP_URL (a running headless Chromium, e.g. ws://localhost:9222, as a reader).

# The model: effort of the research (low | medium | high) and its sampling.
# VEDETTA_DEEP_LOOP_TEMPERATURE=model lets the server apply the model's own sampling.
# LLM_EFFORT_DEEP=medium
# VEDETTA_DEEP_LOOP_TEMPERATURE=1.0
# VEDETTA_DEEP_LOOP_TOP_P=0.95
# Retries when the model's server answers 429/5xx before the answer starts (0 = off).
# VEDETTA_LLM_RETRIES=4
# VEDETTA_LLM_RETRY_MAX_WAIT_SECS=30

# Results per search, and the time limits of the research and of the writing (seconds).
# SEARXNG_MAX_RESULTS=10
# DEEP_SESSION_TIMEOUT_SECS=1200
# SYNTHESIS_TIMEOUT_SECS=1200

# A log with fewer details: steps, counts and errors, no searches or addresses
# (also a switch in Settings, "I tuoi dati").
# VEDETTA_QUIET_LOG=true

# Memory of searches and pages: off | record (normal use) | replay (benchmark).
# What expires is deleted by itself; Settings shows its size and can empty it.
# VEDETTA_CACHE_MODE=record
# VEDETTA_CACHE_SEARCH_TTL=24h
# VEDETTA_CACHE_PAGE_TTL=3h

# Ordering of search results: optional embeddings (blank = built-in BM25), and
# VEDETTA_PRESET_IT=true to favour Italian official sources.
# EMBEDDINGS_URL=
# EMBEDDINGS_API_KEY=
# VEDETTA_PRESET_IT=false

# The experiments left off, and what we saw trying them: guide/experiments.md
# Vedetta's checks are all on; each one can be turned off, for tests:
# VEDETTA_DEEP_LOOP_REVIEW=false            the draft goes back for details not in the sources
# VEDETTA_DEEP_LOOP_REVIEW_PREVIEWS=false   pages seen only in search previews are opened
# VEDETTA_DEEP_LOOP_CITE_READ=false         unopened results are not called sources
# VEDETTA_DEEP_LOOP_LINK_CHECK=false        cited pages the model did not read are opened and compared
# VEDETTA_DEEP_LOOP_QUOTES=false            the passage of a page that says each sentence
# VEDETTA_DEEP_LOOP_SESSION_PAGES=false     follow-ups see the pages of the earlier turns
# VEDETTA_DEEP_LOOP_QUOTE_FALLBACK=false    an empty search with quotes is tried again without
# VEDETTA_CACHE_READ_DATE=false             a page from the memory says the day it was read
# VEDETTA_DEEP_LOOP_KEEP_REASONING=false    the model's reasoning is sent back to it
