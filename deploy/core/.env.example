# Vedetta core: copy this file to .env (cp .env.example .env).
# Nothing here is required: search, reading, model and access code are set in the
# browser, at the first run or in Settings.

# Who can reach Vedetta.
#   127.0.0.1  only this machine (default)
#   0.0.0.0    also the other devices at home: then set an access code in Settings
VEDETTA_PUBLISH=127.0.0.1

# The port on this machine (inside the container Vedetta always uses 3030: do not
# set VEDETTA_PORT here).
VEDETTA_HOST_PORT=3030

# For tinkerers: the variables of the main .env.example (LLM_BASE_URL,
# LLM_API_KEY, VEDETTA_ACCESS_CODE, ...) work here too. What you save in Settings
# wins over them, except the two codes: a code set here wins, and the browser
# cannot change it.
